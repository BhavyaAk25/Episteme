# Copy this file to `.env.local` and fill in your values.

# Required — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended in production so deployments stay explicit and reproducible.
# You may pass a comma-separated list; the first that works is used.
GEMINI_MODEL=gemini-3-flash-preview

# Gemini 3 "thinking" effort: minimal | low (default) | medium | high | off.
# GEMINI_THINKING_LEVEL=low

# --- Optional: use a different free AI provider instead of Gemini ---
# AI_PROVIDER=groq          # groq | openrouter | ollama  (default: gemini)
# AI_API_KEY=               # Groq/OpenRouter key (free tiers). Not needed for Ollama.
# AI_MODEL=                 # defaults: groq llama-3.3-70b-versatile, openrouter meta-llama/llama-3.3-70b-instruct:free, ollama llama3.1
# AI_BASE_URL=              # override the API URL (e.g. a remote Ollama)

# Optional tuning knobs (defaults are sensible; override only if needed).
# GEMINI_MAX_RETRIES_GENERATE=1
# GEMINI_MAX_RETRIES_AUTOFIX=1
# GEMINI_GENERATE_MAX_OUTPUT_TOKENS=16384
# GEMINI_AUTOFIX_MAX_OUTPUT_TOKENS=4096
# GEMINI_RETRY_DELAY_MS=1200
# GEMINI_QUOTA_COOLDOWN_MS=15000
